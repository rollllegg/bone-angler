    },
    {
      "id": "end.admitted.calm",
      "steps": [
        {"text": "wukong.end.admitted.calm.1"},
        {"text": "wukong.end.admitted.calm.2"},
        {"text": "wukong.end.admitted.calm.3"},
        {"text": "wukong.end.ledger.named.1", "if": "named"},
        {"text": "wukong.end.ledger.unnamed.1", "if": "!named"}
      ],
