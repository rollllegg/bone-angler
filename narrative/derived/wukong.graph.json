{
  "id": "wukong",
  "title": "孙悟空",
  "queue_name": "史密斯",
  "entry": "arrival",
  "requires_stats": false,
  "fee": 60,
  "speakers": {
    "孙": {"name": "孙悟空"},
    "圣": {"name": "圣地亚哥"}
