      "steps": [
        {"speaker": "圣", "text": "wukong.identify.1"},
        {"speaker": "孙", "text": "wukong.identify.2"},
        {"speaker": "圣", "text": "wukong.identify.3"},
        {"speaker": "孙", "text": "wukong.identify.4"}
