      "clue.coin": {"type": "int", "default": 0},
      "named": {"type": "bool", "default": false},
      "rage": {"type": "bool", "default": true},
      "dose.fed": {"type": "bool", "default": false},
      "dose.score": {"type": "int", "default": 0},
      "dose.label": {"type": "string", "default": ""}
    }
  },
  "nodes": [
    {
      "id": "arrival",
      "steps": [
        {"text": "wukong.arrival.1"},
        {"speaker": "孙", "text": "wukong.arrival.2"},
        {"speaker": "圣", "text": "wukong.arrival.3"},
        {"speaker": "孙", "text": "wukong.arrival.4"}
      ],
      "next": "inspect"
    },
    {
      "id": "inspect",
      "steps": [
        {"speaker": "圣", "text": "wukong.inspect.1", "if": "!named"},
        {"speaker": "孙", "text": "wukong.inspect.2", "if": "!named"},
        {"speaker": "圣", "text": "wukong.inspect.named.1", "if": "named"},
        {"speaker": "孙", "text": "wukong.inspect.named.2", "if": "named"}
      ],
      "choices": [
        {
          "id": "photo",
          "text": "wukong.choice.photo",
          "if": "clue.photo == 0",
          "set": ["clue.photo = 1"],
          "next": "inspect.photo"
        },
        {
          "id": "tail",
          "text": "wukong.choice.tail",
          "if": "clue.tail == 0",
          "set": ["clue.tail = 1"],
          "next": "inspect.tail"
        },
        {
          "id": "staff",
          "text": "wukong.choice.staff",
          "if": "clue.staff == 0",
          "set": ["clue.staff = 1"],
          "next": "inspect.staff"
        },
        {
          "id": "coin",
          "text": "wukong.choice.coin",
          "if": "clue.coin == 0",
          "set": ["clue.coin = 1"],
          "next": "inspect.coin"
        },
        {
          "id": "name",
          "text": "wukong.choice.name",
          "if": "named == false && clue.photo + clue.tail + clue.staff + clue.coin >= 2",
          "next": "identify"
        },
        {
          "id": "admit",
          "text": "wukong.choice.admit",
          "next": "end.admit"
        },
        {
          "id": "refuse",
          "text": "wukong.choice.refuse",
          "next": "end.refuse"
        }
      ]
    },
    {
      "id": "inspect.photo",
      "steps": [
        {"speaker": "圣", "text": "wukong.inspect.photo.1"},
        {"speaker": "孙", "text": "wukong.inspect.photo.2"}
